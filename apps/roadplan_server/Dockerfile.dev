FROM python:3.11

RUN pip install --upgrade pip

# Install uv
RUN curl -LsSf https://astral.sh/uv/0.5.31/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# install pkg dependencies
RUN apt-get update && apt-get install -y \
    make \
    postgresql postgresql-client

# install geodb pkg dependencies
RUN apt-get update && apt-get install -y \
    binutils \
    libproj-dev \
    gdal-bin

# install dev pkg dependencies
RUN apt-get update && apt-get install -y \
    curl \
    fish \
    nano

# Install the libraries
COPY --from=roadplan pyproject.toml setup.py README.md justfile /app/libs/roadplan/

# Install the server
COPY ./pyproject.toml ./setup.py ./README.md ./requirements*.txt ./requirements.editable /app/src/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -e /app/src -r /app/src/requirements.editable -r /app/src/requirements.txt -r /app/src/requirements.dev.txt

# install dev pip dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    black \
    ipython \
    isort \
    pgcli==3.4.1 \
    pudb

WORKDIR /app/src
