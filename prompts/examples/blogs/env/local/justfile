import './just/docker/_build.just'
import './just/docker/_up.just'
import './just/docker/_run_image.just'
import './just/docker/_up.just'
import './just/docker/_down.just'

set dotenv-load := true
set dotenv-filename := 'env/local/.local.env'

# Determine root properties
export ROOT_DIR := canonicalize(source_directory() / "../..")
export HOST_IP := env_var_or_default("HOST_IP", `ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v 127.0.0.1 | head -1 || echo ""`)
export PYTHON := `which python3 2>/dev/null || which python`

# Determine compose properties
export COMPOSE_DIR := source_directory() / "docker"
export COMPOSE_PROJECT_NAME := "blogs"

build use_no_cache="false": \
    (compile-env-files) \
    (_build use_no_cache)

touch:
    touch ${ROOT_DIR}/env/local/docker/docker-compose.override.yml

compile-env-files:
    touch ${ROOT_DIR}/env/local/secrets.env
    python ${ROOT_DIR}/env/local/scripts/compile_env_files.py \
        --input=${ROOT_DIR}/env/local/secrets.env \
        ${ROOT_DIR}/env/local/docker/env_files

up: \
    (touch) \
    (compile-env-files) \
    (_up "true" "true")

down: \
    (compile-env-files) \
    (_down "true" "true")

render-specs:
    sunya render --create-simple-output-dir --watch

shell service_name: \
    (compile-env-files) \
    (_run_image service_name "true" "true" "true" "fish")

debug:
    echo "JUST_SHELL_COMMAND: ${JUST_SHELL_COMMAND}"