        crops=create_plot_form.crops or [],
        project_id=project.id,
        organization_id=organization.id,
    )
    plot.save()

    return plot


def _validate_args(create_plot_form: CreatePlotForm, organization):
    if create_plot_form.type != PlotType.CROPLAND and create_plot_form.crops:
        raise CropsCanOnlyBeSetForCroplandPlotsError()

    if Plot.objects.filter(name=create_plot_form.name, organization=organization).exists():
        raise PlotNameAlreadyExistsInOrgError()
