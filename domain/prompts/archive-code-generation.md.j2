# plots/views/create_plot_view.py

# This serializer is used in CreatePlotFormSerializer to create the form-argument
# of the create_plot action. Further details are provided when we look at the
# CreatePlotFormSerializer.
class PlotFormSerializer(FormSerializer):
    class Meta:
        form_class = PlotForm

# This serializer parses the request that is sent to the create-plot api-view.
# It uses the PlotFormSerializer to parse the plot-form argument that is passed
# to the create_plot action.
# When filling out the api-view form, you should
# consider the arguments that are passed to the action functions, and find out
# how these arguments can be obtained from the request data.
class CreatePlotFormSerializer(FormSerializer):
    # We use the <request-serializer.fields> form-field to list the fields of
    # the request-serializer.
    plot_form = PlotFormSerializer()
    project_id = serializers.UUIDField(required=False, default=None)
    organization_id = serializers.UUIDField()

class CreatePlotApiView(APIView):
    # The extend_schema decorator is used to annotate the api-view with
    # various types of information. Every api-view uses this decorator.
    @extend_schema(
        # Here, we use the <request-serializer.class-name> form-field to specify the
        # serializer that is used for parsing the request data.
        request=CreatePlotFormSerializer,
        # Here, we use the <response-serializer.class-name> form-field to specify the
        # serializer that is used for formatting the response.
        responses={200: PlotSerializer},
        # The data_spec field is used to specify the variables that are provided by the data-spec.
        # The fields in the request data are available as the starting point for resolving
        # the variables that are described in the data-spec.
        # The <variables-provided-by-data-spec> form-field is used to list the variables that are
        # provided by the data-spec.
        data_spec=dict(
            # The organization variable is resolved from the organization_id field in the request data
            # using the get_organization_or_404 function. In general, you are free to suggest a
            # resolution function such as get_organization_or_404 by simply mentioning the function name.
            organization=get_organization_or_404,
            # The project variable is resolved from the project_id field in the request data
            # using a lambda function. In general, you are free to suggest a lambda function to
            # resolve a variable in the data-spec.
            project=lambda project_id: (
                get_project_or_404(project_id) if project_id else None
            ),
        ),
        # The <permission-functions-used> form-field is used to specify the permission functions that are used
        # to check if the user has the right to perform the action.
        permissions=[
            # You are free to suggest a permission function such as user_is_org_admin_or_editor simply by
            # mentioning the function name. The arguments of the function are resolved using the data-spec.
            (
                403,
                user_is_org_admin_or_editor,
                "You must be an organization admin/editor to create new plots.",
            ),
        ],
    )
    # Here we see the function that handles the request. It always receives the request_data argument.
    # The request_data argument is an object that contains the parsed request data.
    # The <variables-in-keyword-arguments> form-field is used to specify the variables that are passed
    # to the function as keyword arguments. These variables are resolved using the data-spec.
    def post(self, request, request_data, project, organization):
        # Here we call the action functions that are needed to carry out the work of the api-view.
        # The <actions-used> form-field is used to list the action functions that are used in the api-view.
        # The <actions-used.name> form-field is used to specify the name of the action function.
        # The <actions-used.arguments> form-field is used to specify the arguments that are passed to the action function.
        # The <actions-used.validation-exceptions-handled> form-field is used to specify the exceptions that are caught.
        try:
            plot = create_plot_in_project(
                plot_form=plot_form,
                project=project,
                organization=organization,
            )
        except CropsCanOnlyBeSetForCroplandPlotsError:
            # When a validation exception is caught we turn it into a ValidationError.
            raise ValidationError(
                {
                    "plot_form": {
                        "crops": [_("The plot name already exists for this organization")]
                    }
                }
            )
        except PlotNameAlreadyExistsInOrgError:
            raise ValidationError(
                {"non_field_errors": [_("The plot name already exists for this organization")]}
            )
        # Here we use the <response-serializer.class-name> form-field to specify the serializer that
        # is used to format the response.
        return Response(PlotSerializer(plot).data, status=status.HTTP_201_CREATED)
