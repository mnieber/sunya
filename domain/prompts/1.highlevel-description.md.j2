Here is the code-snippet.

```python
from dataclassy import dataclass

class BlogPostWithNameAlreadyExistsError(Exception):
    pass


@dataclass
class CreateBlogPostForm:
    name: str
    content: str


def create_blog_post(
    create_blog_post_form: CreateBlogPostForm,
    blog: Blog
):
    _validate_args(create_blog_post_form, blog)

    blog_post = BlogPost(
        name=create_blog_post_form.name,
        content=create_blog_post_form.content,
        blog_id=blog.id,
    )
    blog_post.save()

    return blog_post


def _validate_args(create_blog_post_form: CreateBlogPostForm, blog):
    if BlogPost.objects.filter(name=create_plot_form.name, blog=blog).exists():
        raise BlogPostWithNameAlreadyExistsError()
```

